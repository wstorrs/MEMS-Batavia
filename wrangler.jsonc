{
  "name": "mems-batavia",
  "compatibility_date": "2026-07-16",

  "assets": {
    "directory": ".",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "batavia-vehicle-auth",
      "database_id": "6232786c-d001-4b09-9df5-65f152a855da"
    }
  ]
}
